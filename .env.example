# Copy this file to .env or supply equivalent variables through the deployment
# environment. Empty values are required secrets; do not commit real values.
# Generate ORCHESTRATOR_DATA_ENCRYPTION_KEY with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

ORCHESTRATOR_ENVIRONMENT=production
ORCHESTRATOR_WORKER_NAME=orchestrator-worker
WORKER_REGION=default
ORCHESTRATOR_WORKER_SECRET=
ORCHESTRATOR_JWT_SECRET=
ORCHESTRATOR_JWT_EXPIRE_MINUTES=60
ORCHESTRATOR_JWT_REFRESH_EXPIRE_DAYS=30

ORCHESTRATOR_STORAGE_BACKEND=mongo
ORCHESTRATOR_MONGODB_URL=mongodb://mongo:27017/orchestrator
ORCHESTRATOR_MONGODB_DATABASE=orchestrator
ORCHESTRATOR_MONGODB_TIMEOUT_MS=5000
ORCHESTRATOR_DATA_ENCRYPTION_KEY=

ORCHESTRATOR_TASK_DISPATCHER=celery
ORCHESTRATOR_CELERY_BROKER_URL=redis://redis:6379/0
ORCHESTRATOR_CELERY_BUILD_QUEUE=orchestrator.builds
ORCHESTRATOR_CELERY_IMAGES_QUEUE=orchestrator.images
ORCHESTRATOR_CELERY_POLL_INTERVAL_SECONDS=15
ORCHESTRATOR_CELERY_MAX_POLL_ATTEMPTS=240
ORCHESTRATOR_CELERY_RECOVERY_INTERVAL_SECONDS=300
ORCHESTRATOR_BASE_IMAGE_SYNC_INTERVAL_HOURS=24

ORCHESTRATOR_GITLAB_URL=
ORCHESTRATOR_GITLAB_TOKEN=
ORCHESTRATOR_JENKINS_URL=
ORCHESTRATOR_JENKINS_USER=
ORCHESTRATOR_JENKINS_PASSWORD=
ORCHESTRATOR_JENKINS_JOB_NAME=apps-orchestrator
ORCHESTRATOR_HARBOR_URL=
ORCHESTRATOR_HARBOR_USER=
ORCHESTRATOR_HARBOR_PASSWORD=
ORCHESTRATOR_HARBOR_PROJECT=apps
ORCHESTRATOR_HARBOR_BOOT_IMAGES_PROJECT=boot-images

# Local Engine mode: keep the Unix URL and socket path. For a remote Engine,
# use a secured tcp:// endpoint and remove the worker socket bind mount in a
# deployment-specific Compose override.
ORCHESTRATOR_DOCKER_BASE_URL=unix:///var/run/docker.sock
ORCHESTRATOR_DOCKER_SOCKET_PATH=/var/run/docker.sock
ORCHESTRATOR_DOCKER_SERVICES_NETWORK=orchestrator
ORCHESTRATOR_DEPLOYMENT_READINESS_TIMEOUT_SECONDS=60
ORCHESTRATOR_DEPLOYMENT_READINESS_POLL_INTERVAL_SECONDS=1
# External published ports are kept when available and reassigned from this
# range when a user request conflicts with another Swarm service.
ORCHESTRATOR_DEPLOYMENT_PORT_RANGE_START=18000
ORCHESTRATOR_DEPLOYMENT_PORT_RANGE_END=18999
ORCHESTRATOR_EXTERNAL_REQUEST_TIMEOUT_SECONDS=30
ORCHESTRATOR_PUBLIC_HOST=
ORCHESTRATOR_PUBLIC_SCHEME=http

# The default port is loopback-only. Set the bind address deliberately when a
# reverse proxy or another host must reach the API.
ORCHESTRATOR_API_BIND_ADDRESS=127.0.0.1
ORCHESTRATOR_API_HOST_PORT=8000
